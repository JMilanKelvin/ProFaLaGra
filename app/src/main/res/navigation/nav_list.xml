            app:destination="@id/editFragment2" />
    </fragment>
    <fragment
        android:id="@+id/editFragment2"
        android:name="com.example.profalagra.features.edicionGraficos.EditFragment"
        android:label="EditFragment" >
        <argument
            android:name="datos"
            app:argType="string[]" />
        <argument
            android:name="numGrafSelect"
            app:argType="integer" />
    </fragment>
